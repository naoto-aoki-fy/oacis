{
    "name": "OACIS Dev Container",
    "dockerComposeFile": "docker-compose.yml",
    "service": "app",
    "workspaceFolder": "/workspace/oacis",
    "shutdownAction": "stopCompose",
    "features": {
        "ghcr.io/devcontainers/features/ruby:1": {
            "version": "2.7"
        },
        "ghcr.io/devcontainers/features/node:1": {
            "version": "lts"
        }
    }
}
